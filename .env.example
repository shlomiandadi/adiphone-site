# Database
DATABASE_URL="postgresql://user:password@localhost:5432/database?schema=public"

# Admin Authentication (set ADMIN_PASSWORD in the Netlify UI, never commit it)
ADMIN_USERNAME="admin"
ADMIN_EMAIL="your-email@example.com"
ADMIN_PASSWORD="your-secure-password"

# JWT Secret
JWT_SECRET="your-jwt-secret-key-change-this-in-production"

# Email Service (Resend)
RESEND_API_KEY="your-resend-api-key"

# SMTP (set these in the Netlify UI — never commit EMAIL_PASS)
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USER="your-gmail@gmail.com"
EMAIL_PASS="your-gmail-app-password"

# Site URLs
NEXT_PUBLIC_API_URL="https://your-domain.com"
NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# OpenAI (for chatbot)
OPENAI_API_KEY="your-openai-api-key"

# SEO Agent — HMAC secret for /api/seo-agent/webhook (articles + apply overrides)
SEO_AGENT_WEBHOOK_SECRET="your-webhook-secret-same-as-seo-agent-ui"

# Optional fallback if Netlify does not inject Blobs context (plugin-nextjs v5 usually does)
# SEO_AGENT_BLOBS_SITE_ID="your-netlify-site-id"
# SEO_AGENT_BLOBS_TOKEN="your-netlify-blobs-or-personal-access-token"

# Node Environment
NODE_ENV="development"
