generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  username  String    @unique
  email     String    @unique
  password  String
  role      Role      @default(AUTHOR)
  isActive  Boolean   @default(true)
  lastLogin DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  posts     Post[]
}

model Post {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String
  content     String
  mainImage   String
  images      String[]
  tags        String[]
  published   Boolean   @default(false)
  authorName  String?
  authorEmail String?
  views       Int       @default(0)
  likes       Int       @default(0)
  metaTitle   String
  metaDesc    String
  articleStyles String? @db.Text
  schemaMarkup  String? @db.Text
  canonicalUrl  String?
  ogImage       String?
  robots        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  authorId    String?
  categoryId  String?
  author      User?     @relation(fields: [authorId], references: [id])
  category    Category? @relation(fields: [categoryId], references: [id])
  postTags    PostTag[]
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  color       String   @default("#3B82F6")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  posts       Post[]
}

model Tag {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  postTags  PostTag[]
}

model PostTag {
  id     String @id @default(cuid())
  postId String
  tagId  String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([postId, tagId])
}

model Contact {
  id        String         @id @default(cuid())
  name      String
  email     String
  phone     String
  message   String
  service   ContactService
  status    ContactStatus  @default(NEW)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model PortfolioProject2 {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  image           String
  images          String[]
  description     String
  descriptionRich String?
  url             String
  date            DateTime
  technologies    String[]
  keywords        String[] @default([])
  published       Boolean  @default(false)
  metaTitle       String?
  metaDesc        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum Role {
  ADMIN
  EDITOR
  AUTHOR
}

enum ContactStatus {
  NEW
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum ContactService {
  WEB_DEVELOPMENT
  SEO
  PPC
  OTHER
}

// Maps onto existing PostgreSQL USER-DEFINED enums exactly. Do not migrate or db push.
enum MenuLocation {
  HEADER_MAIN
  HEADER_SECONDARY
  FOOTER_MAIN
  FOOTER_SECONDARY
  MOBILE
}

enum PageTemplate {
  GENERAL
  SERVICE
  ABOUT
  CONTACT
  LANDING
  BLOG
}

model Breadcrumb {
  id              String   @id @default(cuid())
  pageSlug        String
  breadcrumbData  Json
  isActive        Boolean
  createdAt       DateTime
  updatedAt       DateTime
  cmsEnabled      Boolean?

  @@map("breadcrumbs")
}

model PageHierarchy {
  id               String   @id @default(cuid())
  pageId           String
  pageSlug         String
  pageTitle        String
  parentId         String?
  level            Int
  order            Int
  isActive         Boolean
  showInBreadcrumb Boolean
  breadcrumbTitle  String?
  createdAt        DateTime
  updatedAt        DateTime
  cmsEnabled       Boolean?

  @@map("page_hierarchy")
}

model CanonicalTag {
  id           String   @id @default(cuid())
  pageSlug     String
  canonicalUrl String
  isActive     Boolean
  createdAt    DateTime
  updatedAt    DateTime
  cmsEnabled   Boolean?

  @@map("canonical_tags")
}

model SeoPage {
  id            String   @id @default(cuid())
  page          String
  title         String
  description   String
  keywords      String
  ogTitle       String?
  ogDescription String?
  ogImage       String?
  canonicalUrl  String?
  robots        String
  createdAt     DateTime
  updatedAt     DateTime
  cmsEnabled    Boolean?

  @@map("seo")
}

model SiteSetting {
  id                 String   @id @default(cuid())
  siteName           String
  siteDescription    String?
  siteKeywords       String?
  siteUrl            String?
  siteLogo           String?
  siteFavicon        String?
  googleAnalyticsId  String?
  googleTagManagerId String?
  facebookPixelId    String?
  twitterHandle      String?
  facebookPage       String?
  instagramHandle    String?
  linkedinPage       String?
  createdAt          DateTime
  updatedAt          DateTime
  cmsEnabled         Boolean?

  @@map("site_settings")
}

model RobotsSetting {
  id             String   @id @default(cuid())
  userAgent      String
  allowPaths     String[]
  disallowPaths  String[]
  crawlDelay     Int
  sitemapUrl     String?
  isActive       Boolean
  createdAt      DateTime
  updatedAt      DateTime
  cmsEnabled     Boolean?

  @@map("robots_settings")
}

model SitemapSetting {
  id                String    @id @default(cuid())
  isEnabled         Boolean
  includePages      Boolean
  includePosts      Boolean
  includeCategories Boolean
  includePortfolio  Boolean
  excludePages      String[]
  excludePaths      String[]
  priority          Float
  changeFreq        String
  lastModified      DateTime
  createdAt         DateTime
  updatedAt         DateTime
  cmsEnabled        Boolean?

  @@map("sitemap_settings")
}

model HeaderSetting {
  id                   String   @id @default(cuid())
  logo                 String?
  logoAlt              String?
  logoWidth            Int
  logoHeight           Int
  showSearch           Boolean
  searchPlaceholder    String
  showContactButton    Boolean
  contactButtonText    String
  contactButtonLink    String
  backgroundColor      String
  textColor            String
  stickyHeader         Boolean
  showLanguageSwitcher Boolean
  languages            String[]
  createdAt            DateTime
  updatedAt            DateTime
  cmsEnabled           Boolean?

  @@map("header")
}

model Menu {
  id         String       @id @default(cuid())
  name       String
  location   MenuLocation
  isActive   Boolean
  createdAt  DateTime
  updatedAt  DateTime
  headerId   String?
  cmsEnabled Boolean?
  items      MenuItem[]

  @@map("menus")
}

model MenuItem {
  id           String    @id @default(cuid())
  title        String
  url          String?
  pageId       String?
  order        Int
  isActive     Boolean
  openInNewTab Boolean
  icon         String?
  cssClass     String?
  createdAt    DateTime
  updatedAt    DateTime
  menuId       String
  parentId     String?
  menu         Menu      @relation(fields: [menuId], references: [id])
  parent       MenuItem? @relation("MenuItemTree", fields: [parentId], references: [id])
  children     MenuItem[] @relation("MenuItemTree")
  cmsEnabled   Boolean?

  @@map("menu_items")
}

model FooterSetting {
  id                     String         @id @default(cuid())
  logo                   String?
  logoAlt                String?
  logoWidth              Int
  logoHeight             Int
  description            String?
  backgroundColor        String
  textColor              String
  linkColor              String
  linkHoverColor         String
  showNewsletter         Boolean
  newsletterTitle        String
  newsletterDescription  String
  newsletterPlaceholder  String
  newsletterButtonText   String
  showSocialLinks        Boolean
  copyrightText          String
  createdAt              DateTime
  updatedAt              DateTime
  cmsEnabled             Boolean?
  columns                FooterColumn[]

  @@map("footer")
}

model FooterColumn {
  id         String       @id @default(cuid())
  title      String
  order      Int
  isActive   Boolean
  createdAt  DateTime
  updatedAt  DateTime
  footerId   String
  cmsEnabled Boolean?
  footer     FooterSetting @relation(fields: [footerId], references: [id])
  links      FooterLink[]

  @@map("footer_columns")
}

model FooterLink {
  id           String       @id @default(cuid())
  title        String
  url          String?
  pageId       String?
  order        Int
  isActive     Boolean
  openInNewTab Boolean
  icon         String?
  createdAt    DateTime
  updatedAt    DateTime
  columnId     String
  cmsEnabled   Boolean?
  column       FooterColumn @relation(fields: [columnId], references: [id])

  @@map("footer_links")
}

model TopStrip {
  id              String   @id @default(cuid())
  text            String
  backgroundColor String
  textColor       String
  isActive        Boolean
  showCloseButton Boolean
  linkUrl         String?
  linkText        String?
  createdAt       DateTime
  updatedAt       DateTime
  cmsEnabled      Boolean?

  @@map("top_strip")
}

model Template {
  id          String    @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime
  updatedAt   DateTime
  cmsEnabled  Boolean?
  sections    Section[]
  pages       CmsPage[]

  @@map("templates")
}

model Section {
  id         String   @id @default(cuid())
  type       String
  title      String
  content    Json
  order      Int
  createdAt  DateTime
  updatedAt  DateTime
  templateId String
  cmsEnabled Boolean?
  template   Template @relation(fields: [templateId], references: [id])

  @@map("sections")
}

model CmsPage {
  id                     String        @id @default(cuid())
  title                  String
  slug                   String
  content                String
  excerpt                String?
  template               PageTemplate
  published              Boolean
  order                  Int
  metaTitle              String?
  metaDesc               String?
  metaKeywords           String?
  featuredImage          String?
  heroTitle              String?
  heroSubtitle           String?
  heroImage              String?
  heroButtonText         String?
  heroButtonLink         String?
  serviceFeatures        Json?
  serviceBenefits        Json?
  servicePricing         Json?
  aboutImage             String?
  aboutStats             Json?
  teamMembers            Json?
  contactInfo            Json?
  contactForm            Json?
  landingSections        Json?
  testimonials           Json?
  blogAuthor             String?
  blogCategory           String?
  blogTags               String[]
  createdAt              DateTime
  updatedAt              DateTime
  templateId             String?
  metaCanonical          String?
  metaOgDescription      String?
  metaOgImage            String?
  metaOgTitle            String?
  metaRobots             String?
  metaTwitterCard        String?
  metaTwitterDescription String?
  metaTwitterImage       String?
  metaTwitterTitle       String?
  cmsEnabled             Boolean?
  cmsTemplate            Template?     @relation(fields: [templateId], references: [id])

  @@map("Page")
}
