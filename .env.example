# Database
DATABASE_URL="postgresql://user:password@localhost:5432/database?schema=public"

# Admin Authentication (set ADMIN_PASSWORD in the Netlify UI, never commit it)
ADMIN_USERNAME="admin"
ADMIN_EMAIL="your-email@example.com"
ADMIN_PASSWORD="your-secure-password"

# JWT Secret
JWT_SECRET="your-jwt-secret-key-change-this-in-production"

# Email Service (Resend)
RESEND_API_KEY="your-resend-api-key"

# SMTP (set these in the Netlify UI — never commit EMAIL_PASS)
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USER="your-gmail@gmail.com"
EMAIL_PASS="your-gmail-app-password"

# Site URLs
NEXT_PUBLIC_API_URL="https://your-domain.com"
NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# OpenAI (for chatbot). The route uses gpt-4o-mini.
OPENAI_API_KEY="your-openai-api-key"

# Optional chatbot quotas. Defaults: 10/hour and 30/day per IP, 300 OpenAI calls/day.
# CHATBOT_DAILY_LIMIT="300"
# CHATBOT_IP_HOURLY_LIMIT="10"
# CHATBOT_IP_DAILY_LIMIT="30"

# Optional Cloudflare Turnstile. Leave unset and the chatbot skips the check.
# When TURNSTILE_SECRET_KEY is set, /api/chatbot requires a valid turnstileToken.
# TURNSTILE_SECRET_KEY="your-turnstile-secret"

# SEO Agent — HMAC secret for /api/seo-agent/webhook (articles + apply overrides)
SEO_AGENT_WEBHOOK_SECRET="your-webhook-secret-same-as-seo-agent-ui"

# Optional Blobs mirror for Edge redirects. Page metadata is stored in Neon via DATABASE_URL.
# SEO_AGENT_BLOBS_SITE_ID="your-netlify-site-id"
# SEO_AGENT_BLOBS_TOKEN="your-netlify-blobs-or-personal-access-token"

# Meta Conversions API — server-side Lead, deduped with pixel 1317769456632052.
# Leave META_CAPI_TOKEN unset to disable the call (the contact form still succeeds).
# META_TEST_EVENT_CODE is optional; when set it is sent as test_event_code.
# META_CAPI_TOKEN="your-meta-conversions-api-access-token"
# META_TEST_EVENT_CODE="TEST12345"

# Node Environment
NODE_ENV="development"
